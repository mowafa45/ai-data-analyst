# Frontend environment — copy to .env.local and fill in values

# Python backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Anthropic (used by Next.js API routes directly — never expose to browser)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Clerk authentication (optional — remove Clerk imports if not using)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
